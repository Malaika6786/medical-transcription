# nginx template for the docker-compose proxy service.
# ${AI_PROXY_TOKEN} is substituted by the nginx image's envsubst entrypoint.
server {
    listen 8443;

    proxy_read_timeout  300s;
    proxy_send_timeout  300s;
    client_max_body_size 10m;

    location /v1/ {
        if ($http_authorization != "Bearer ${AI_PROXY_TOKEN}") {
            return 401 '{"error":"unauthorized"}';
        }
        proxy_pass http://ollama:11434;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_buffering off;
    }

    location = /healthz {
        return 200 'ok';
    }

    location / {
        return 404;
    }
}
