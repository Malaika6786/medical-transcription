# =================================
# Corti Medical Transcription Demo
# Root .gitignore
# =================================

# =================================
# IDE & Editor
# =================================
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# =================================
# OS Generated Files
# =================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# =================================
# Environment Files
# =================================
.env
.env.local
.env.*.local
*.env
!.env.example

# =================================
# Logs
# =================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =================================
# Temporary Files
# =================================
tmp/
temp/
.tmp/
.temp/
*.tmp
*.bak
*.backup

# =================================
# Database Backups
# scripts/backup_db.sh writes here. Dumps contain patient transcripts and
# bcrypt password hashes — never commit them.
# =================================
backups/
*.dump

# =================================
# Build Outputs
# =================================
dist/
build/
out/
*.exe
*.dll
*.so
*.dylib

# =================================
# Test & Coverage
# =================================
coverage/
.nyc_output/
*.cover
*.out

