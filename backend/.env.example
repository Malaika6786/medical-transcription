# Corti API Configuration
# TODO: Replace these with your actual Corti credentials from https://console.corti.app
CORTI_CLIENT_ID=your_client_id_here
CORTI_CLIENT_SECRET=your_client_secret_here

# Corti API Endpoints
CORTI_TENANT=base
CORTI_ENVIRONMENT=us
CORTI_AUTH_URL=https://auth.us.corti.app/realms/base/protocol/openid-connect/token
CORTI_API_BASE_URL=https://api.us.corti.app
CORTI_WS_URL=wss://api.us.corti.app/stt/stream

# Embedded Assistant (ROPC) — shared backend user provisioned via the Corti Admin API
# Required for the /embedded-assistant page; without these the /api/embedded/token endpoint returns 500
CORTI_EMBEDDED_CLIENT_ID=your_embedded_client_id_here
CORTI_EMBEDDED_USERNAME=your_embedded_username_here
CORTI_EMBEDDED_PASSWORD=your_embedded_password_here

# Server Configuration
# 8090, not 8080: port 8080 is commonly taken (Open WebUI and friends).
# frontend/.env.local must carry the matching VITE_BACKEND_URL — see docs/SETUP.md.
SERVER_PORT=8090
SERVER_HOST=0.0.0.0

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Signs login JWTs. Generate one with: openssl rand -base64 48
# Without it the server falls back to a hardcoded demo secret and logs a warning.
JWT_SECRET=

# Logging
LOG_LEVEL=debug

# Token refresh buffer (seconds before expiry to refresh)
TOKEN_REFRESH_BUFFER=60

# ============================================
# AI Assistance module (summary + grounded Q&A)
# Any OpenAI-compatible /v1/chat/completions endpoint works — the provider is
# chosen purely by these vars (local Ollama, a GPU VM, Groq, ...).
# ============================================
# Live demo hosted provider (see the Feishu provider guide):
# https://mcnbwp173aty.feishu.cn/docx/QzgXdQlvKojzLxxLvtcc0cSpnye
AI_BASE_URL=https://api.llm-token.cn/v1
AI_MODEL=deepseek-v4-flash
AI_API_KEY=your_ai_api_key_here
AI_TEMPERATURE=0.2
# Local Ollama fallback: AI_BASE_URL=http://localhost:11434/v1
# Local fallback model: AI_MODEL=qwythos-16k-chat
# Empty for local Ollama; required for the hosted provider.
# Hosted extraction should complete well within this timeout.
AI_TIMEOUT_SECONDS=300
# Hard cap for generated output, including hidden reasoning tokens.
# Sized for the reasoning trace + the full 15-field clinical extraction
# (2048 truncated intermittently in local testing).
AI_MAX_COMPLETION_TOKENS=4096

# ============================================
# Database (PostgreSQL + pgvector — system of record, docs/adr/0001)
# Local setup: brew services start postgresql@17 && createdb meditrans
#   (or: docker compose up -d   — see docker-compose.yml at the repo root)
# Import legacy JSON data once with: go run ./cmd/migrate-json
# ============================================
DATABASE_URL=postgres://localhost:5432/meditrans?sslmode=disable

# ============================================
# Embedding model (bge-small-en-v1.5, 384 dims — docs/adr/0002)
# Any OpenAI-compatible /v1/embeddings endpoint. Configured separately from
# AI_BASE_URL because the chat provider may not serve embedding models.
# Local Ollama setup: ollama pull hf.co/CompendiumLabs/bge-small-en-v1.5-gguf
# ============================================
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_MODEL=hf.co/CompendiumLabs/bge-small-en-v1.5-gguf
EMBED_API_KEY=
EMBED_TIMEOUT_SECONDS=60

# ============================================
# Data residency guard (utils.ValidateDataResidency) — see
# SYSTMONE_INTEGRATION_REPORT.md, "Default AI data flows are not UK-hosted".
# When true (the code default if this var is absent entirely), the server
# refuses to start unless CORTI_ENVIRONMENT is "eu"/"uk" and AI_BASE_URL
# points at localhost/a private endpoint you control.
#
# This demo's shipped defaults above (CORTI_ENVIRONMENT=us, the hosted
# AI_BASE_URL) are for synthetic/demo data only and do NOT pass that check
# — hence explicitly false here. Flip to true (or delete this line) the
# moment this deployment might ever touch a real patient's data, and switch
# CORTI_ENVIRONMENT/AI_BASE_URL to UK/EU-hosted or self-hosted values first.
DATA_RESIDENCY_UK_ONLY=false

# ============================================
# Field-level encryption for patient PII (internal/cryptofield) — see
# SYSTMONE_INTEGRATION_REPORT.md, "No encryption at application/database
# field level". Generate with: openssl rand -hex 32
# Leave empty for local/demo use with no real patients — the /api/patients
# and /api/nhs/* routes simply won't be registered (see main.go), nothing
# else is affected.
# ============================================
FIELD_ENCRYPTION_KEY=

# ============================================
# NHS/SystmOne integration (internal/nhs) — see docs/nhs/README.md and
# docs/regulatory/PREREQUISITES.md for what each of these unlocks and what
# organisational/legal steps must happen before they can reach a real NHS
# environment. All empty/default here is fine until that groundwork exists.
# ============================================
# PDS (Personal Demographics Service) — defaults to NHS's public sandbox,
# which serves synthetic test patients only, no real credentials needed.
PDS_BASE_URL=https://sandbox.api.service.nhs.uk/personal-demographics/FHIR/R4
PDS_API_KEY=

# MESH (transport for GP Connect: Send Document) — has no working default;
# a mailbox ID/password/shared key are issued when your organisation
# registers with NHS Digital.
MESH_BASE_URL=https://msg.intspineservices.nhs.uk
MESH_MAILBOX_ID=
MESH_MAILBOX_PASSWORD=
MESH_SHARED_KEY=

# This organisation's ODS (Organisation Data Service) code — assigned on
# supplier/provider registration, used as the FHIR message author identity.
NHS_ORG_ODS_CODE=

# NHS CIS2 (OpenID Connect) — only needed if a future NHS API call this
# project makes requires a user-restricted (clinician-identity-bound) token
# rather than a system credential. Not required for GP Connect: Send
# Document or MESH, which are both system-to-system.
CIS2_ISSUER_URL=
CIS2_CLIENT_ID=
CIS2_CLIENT_SECRET=
CIS2_REDIRECT_URL=
